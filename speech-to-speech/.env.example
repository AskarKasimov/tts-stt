# Та же карта, на которой работают GigaAM/VoxCPM2. На однокарточном сервере — 0.
GPU_ID=0
S2S_PORT=8091
# HTTP API для приложения (multipart upload); как GigaAM, доступен на всех интерфейсах.
S2S_API_PORT=8002
S2S_API_BIND=0.0.0.0
# Каталог с весами: требуется минимум 40 GiB свободного места.
# Для другого диска укажите абсолютный путь, например /srv/qwen3-omni.
S2S_DATA_DIR=./data
# Необязательно для публичной модели. Нужен при ограничениях Hugging Face.
HF_TOKEN=
